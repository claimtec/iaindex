# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_... # Your Stripe secret key (test mode)
STRIPE_WEBHOOK_SECRET=whsec_... # Your webhook signing secret (optional)

# Application URLs
APP_URL=https://app.iaindex.org # Dashboard URL
SITE_URL=http://localhost:3001 # Scan tool URL

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# JWT Configuration
SECRET_KEY=your-secret-key-for-jwt
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# API Configuration
APP_NAME=IAIndex Verification API
APP_VERSION=1.1.0
DEBUG=true

# CORS Origins
CORS_ORIGINS=http://localhost:3001,https://scan.iaindex.org,https://app.iaindex.org

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60/minute
RATE_LIMIT_PER_HOUR=1000/hour

# Provider API Keys (optional)
OPENAI_API_KEY=your-openai-api-key
ANTHROPIC_API_KEY=your-anthropic-api-key
