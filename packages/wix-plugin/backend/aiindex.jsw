/**
 * AI Index Backend Module for Wix
 *
 * This module handles:
 * - Generating ai-index.json from Wix site content
 * - Publishing to AI Index API
 * - HTTP Functions for serving the JSON file
 * - Webhook notifications on content changes
 *
 * @module backend/aiindex
 */

import { fetch } from 'wix-fetch';
import wixData from 'wix-data';
import { getSecret } from 'wix-secrets-backend';

const AI_INDEX_API_BASE = 'https://api.aiindex.com/v1';

/**
 * Get configuration from Wix Data Collections or Secrets
 */
async function getConfig() {
  try {
    const apiKey = await getSecret('aiIndexApiKey');
    const config = await wixData.query('AIIndexConfig')
      .limit(1)
      .find();

    return {
      apiKey: apiKey,
      webhookUrl: config.items[0]?.webhookUrl || null,
      autoPublish: config.items[0]?.autoPublish !== false,
      includePages: config.items[0]?.includePages !== false,
      includeBlog: config.items[0]?.includeBlog !== false,
      includeProducts: config.items[0]?.includeProducts || false
    };
  } catch (error) {
    console.error('Error loading config:', error);
    return null;
  }
}

/**
 * Generate AI Index JSON from Wix site content
 */
export async function generateAIIndex() {
  const config = await getConfig();
  if (!config) {
    throw new Error('AI Index not configured');
  }

  const siteUrl = wixData.siteUrl();
  const siteName = wixData.siteName();

  const aiIndex = {
    version: '1.0',
    metadata: {
      site_name: siteName,
      base_url: siteUrl,
      last_updated: new Date().toISOString(),
      language: 'en',
      contact: {
        email: 'support@' + siteUrl.replace(/^https?:\/\//, '').replace(/\/$/, '')
      }
    },
    pages: []
  };

  // Fetch static pages
  if (config.includePages) {
    const pages = await wixData.query('SitePages').find();
    for (const page of pages.items) {
      if (page.isVisible && !page.isHidden) {
        aiIndex.pages.push({
          url: `${siteUrl}${page.url}`,
          title: page.title,
          description: page.description || '',
          last_modified: page.lastModified || new Date().toISOString(),
          content_type: 'page',
          keywords: page.keywords || []
        });
      }
    }
  }

  // Fetch blog posts
  if (config.includeBlog) {
    try {
      const posts = await wixData.query('Blog/Posts')
        .eq('status', 'published')
        .find();

      for (const post of posts.items) {
        aiIndex.pages.push({
          url: `${siteUrl}/blog/${post.slug}`,
          title: post.title,
          description: post.excerpt || post.plainContent?.substring(0, 200) || '',
          last_modified: post.lastPublishedDate || post._updatedDate,
          content_type: 'blog_post',
          author: post.author?.name,
          published_date: post.firstPublishedDate,
          keywords: post.hashtags || []
        });
      }
    } catch (error) {
      console.log('Blog not available or error fetching posts:', error);
    }
  }

  // Fetch products
  if (config.includeProducts) {
    try {
      const products = await wixData.query('Stores/Products')
        .eq('visible', true)
        .find();

      for (const product of products.items) {
        aiIndex.pages.push({
          url: `${siteUrl}/product-page/${product.slug}`,
          title: product.name,
          description: product.description || '',
          last_modified: product._updatedDate,
          content_type: 'product',
          price: product.price,
          currency: product.currency,
          in_stock: product.trackInventory ? product.inventory > 0 : true,
          keywords: product.productType ? [product.productType] : []
        });
      }
    } catch (error) {
      console.log('Store not available or error fetching products:', error);
    }
  }

  return aiIndex;
}

/**
 * Publish AI Index to the API
 */
export async function publishToAPI(aiIndexData) {
  const config = await getConfig();
  if (!config || !config.apiKey) {
    throw new Error('API key not configured');
  }

  const response = await fetch(`${AI_INDEX_API_BASE}/publish`, {
    method: 'POST',
    headers: {
      'Content-Type': 'application/json',
      'Authorization': `Bearer ${config.apiKey}`
    },
    body: JSON.stringify(aiIndexData)
  });

  if (!response.ok) {
    const error = await response.text();
    throw new Error(`Failed to publish: ${error}`);
  }

  return await response.json();
}

/**
 * Save configuration
 */
export async function saveConfig(configData) {
  try {
    // Check if config exists
    const existing = await wixData.query('AIIndexConfig')
      .limit(1)
      .find();

    if (existing.items.length > 0) {
      // Update existing
      await wixData.update('AIIndexConfig', {
        _id: existing.items[0]._id,
        ...configData,
        _updatedDate: new Date()
      });
    } else {
      // Insert new
      await wixData.insert('AIIndexConfig', configData);
    }

    return { success: true };
  } catch (error) {
    console.error('Error saving config:', error);
    throw error;
  }
}

/**
 * Get analytics data
 */
export async function getAnalytics() {
  try {
    const config = await getConfig();
    if (!config || !config.apiKey) {
      return { error: 'Not configured' };
    }

    const response = await fetch(`${AI_INDEX_API_BASE}/analytics`, {
      method: 'GET',
      headers: {
        'Authorization': `Bearer ${config.apiKey}`
      }
    });

    if (!response.ok) {
      return { error: 'Failed to fetch analytics' };
    }

    return await response.json();
  } catch (error) {
    console.error('Error fetching analytics:', error);
    return { error: error.message };
  }
}

/**
 * Verify API key
 */
export async function verifyApiKey(apiKey) {
  try {
    const response = await fetch(`${AI_INDEX_API_BASE}/verify`, {
      method: 'GET',
      headers: {
        'Authorization': `Bearer ${apiKey}`
      }
    });

    return {
      valid: response.ok,
      status: response.status
    };
  } catch (error) {
    return {
      valid: false,
      error: error.message
    };
  }
}

/**
 * HTTP Function: Serve ai-index.json
 * Accessible at https://yoursite.com/_functions/ai-index.json
 */
export async function get_aiindex(request) {
  try {
    const aiIndex = await generateAIIndex();

    return {
      status: 200,
      headers: {
        'Content-Type': 'application/json',
        'Access-Control-Allow-Origin': '*',
        'Cache-Control': 'public, max-age=3600'
      },
      body: JSON.stringify(aiIndex, null, 2)
    };
  } catch (error) {
    console.error('Error generating AI Index:', error);
    return {
      status: 500,
      headers: {
        'Content-Type': 'application/json'
      },
      body: JSON.stringify({ error: error.message })
    };
  }
}

/**
 * Webhook handler for content changes
 * Call this from Wix Data Hooks
 */
export async function handleContentChange(item, context) {
  const config = await getConfig();

  if (!config || !config.autoPublish) {
    return;
  }

  try {
    // Regenerate and publish
    const aiIndex = await generateAIIndex();
    await publishToAPI(aiIndex);

    // Send webhook notification if configured
    if (config.webhookUrl) {
      await fetch(config.webhookUrl, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify({
          event: 'content_updated',
          timestamp: new Date().toISOString(),
          item_id: item._id,
          collection: context.collectionId
        })
      });
    }
  } catch (error) {
    console.error('Error handling content change:', error);
  }
}
