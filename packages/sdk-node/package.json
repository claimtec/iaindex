{
  "name": "@aiindex/sdk",
  "version": "1.0.0",
  "description": "Official Node.js SDK for AIIndex - Generate and manage AI Index files for AI agent discovery",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "bin": {
    "aiindex-gen": "./dist/cli.js"
  },
  "scripts": {
    "build": "npm run build:cjs && npm run build:esm && npm run build:types",
    "build:cjs": "tsc --module commonjs --outDir dist",
    "build:esm": "tsc --module esnext --outDir dist/esm && node scripts/rename-esm.js",
    "build:types": "tsc --declaration --emitDeclarationOnly --outDir dist",
    "prepublishOnly": "npm run build",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "keywords": [
    "aiindex",
    "ai-agent",
    "discovery",
    "metadata",
    "seo",
    "ai",
    "sdk",
    "generator",
    "webhook"
  ],
  "author": "AIIndex Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/aiindex/sdk-node.git"
  },
  "bugs": {
    "url": "https://github.com/aiindex/sdk-node/issues"
  },
  "homepage": "https://github.com/aiindex/sdk-node#readme",
  "dependencies": {
    "commander": "^11.1.0",
    "axios": "^1.6.2",
    "cheerio": "^1.0.0-rc.12",
    "jose": "^5.2.0",
    "chalk": "^4.1.2",
    "ora": "^5.4.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.5",
    "typescript": "^5.3.3",
    "@types/jest": "^29.5.11",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.1",
    "eslint": "^8.56.0",
    "prettier": "^3.1.1",
    "@typescript-eslint/eslint-plugin": "^6.15.0",
    "@typescript-eslint/parser": "^6.15.0"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ]
}
