{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aiindex.org/schemas/v1/receipts.schema.json",
  "title": "AIIndex Access Receipt Schema",
  "description": "Proof-of-access receipt format for AI agent visits",
  "type": "object",
  "required": [
    "version",
    "receipt_id",
    "publisher_id",
    "client_id",
    "timestamp",
    "signature"
  ],
  "properties": {
    "version": {
      "type": "string",
      "description": "Receipt format version",
      "pattern": "^1\\.0$",
      "default": "1.0"
    },
    "receipt_id": {
      "type": "string",
      "description": "Unique receipt identifier (UUID v4)",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "publisher_id": {
      "type": "string",
      "description": "Publisher identifier (must match ai-index.json)",
      "minLength": 3,
      "maxLength": 255
    },
    "publisher_domain": {
      "type": "string",
      "description": "Publisher domain accessed",
      "format": "hostname"
    },
    "client_id": {
      "type": "string",
      "description": "AI client/agent identifier",
      "minLength": 3,
      "maxLength": 255
    },
    "client_name": {
      "type": "string",
      "description": "Human-readable client name",
      "examples": ["OpenAI GPT-4", "Anthropic Claude", "Custom LLM App"]
    },
    "client_version": {
      "type": "string",
      "description": "Client software version"
    },
    "timestamp": {
      "type": "string",
      "description": "ISO 8601 timestamp of access",
      "format": "date-time"
    },
    "access": {
      "type": "object",
      "description": "Access details",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri",
          "description": "URL of ai-index.json file accessed"
        },
        "method": {
          "type": "string",
          "enum": ["GET", "POST"],
          "default": "GET"
        },
        "status_code": {
          "type": "integer",
          "description": "HTTP status code received",
          "minimum": 200,
          "maximum": 599
        },
        "content_hash": {
          "type": "string",
          "description": "SHA-256 hash of retrieved content"
        },
        "pages_accessed": {
          "type": "array",
          "description": "Specific pages from index that were used",
          "items": {
            "type": "string",
            "format": "uri"
          }
        }
      }
    },
    "purpose": {
      "type": "object",
      "description": "Purpose of access",
      "properties": {
        "type": {
          "type": "string",
          "enum": ["training", "inference", "research", "indexing", "other"],
          "description": "Type of use"
        },
        "description": {
          "type": "string",
          "description": "Detailed purpose description"
        },
        "commercial": {
          "type": "boolean",
          "description": "Whether use is commercial"
        }
      }
    },
    "attribution": {
      "type": "object",
      "description": "How content will be attributed",
      "properties": {
        "method": {
          "type": "string",
          "enum": ["citation", "link", "inline", "none"],
          "description": "Attribution method"
        },
        "citation_text": {
          "type": "string",
          "description": "Citation text if applicable"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "description": "URL where attribution appears"
        }
      }
    },
    "signature": {
      "type": "object",
      "description": "Cryptographic signature from client",
      "required": ["algorithm", "kid", "signature", "payload_hash"],
      "properties": {
        "algorithm": {
          "type": "string",
          "enum": ["ES256", "RS256"],
          "description": "Signature algorithm"
        },
        "kid": {
          "type": "string",
          "description": "Client's key ID"
        },
        "signature": {
          "type": "string",
          "description": "Base64-encoded signature of receipt payload"
        },
        "payload_hash": {
          "type": "string",
          "description": "SHA-256 hash of signed fields"
        }
      }
    },
    "metadata": {
      "type": "object",
      "description": "Additional metadata",
      "properties": {
        "user_agent": {
          "type": "string",
          "description": "HTTP User-Agent string"
        },
        "sdk_version": {
          "type": "string",
          "description": "AIIndex SDK version used"
        },
        "request_id": {
          "type": "string",
          "description": "Client's internal request ID"
        }
      },
      "additionalProperties": true
    }
  }
}
